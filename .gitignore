# Node
node_modules/
dist/
*.log
.env

# Flutter
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/**/generated_plugin_registrant.dart
# Generated code (Drift, etc.) — regenerated via build_runner in CI/local
app/**/*.g.dart

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store

# AI assistant session files
.claude/
.superpowers/

# Interview/recording transcripts — may contain third-party PII
*.pdf
!docs/**/*.pdf
# …and test goldens, which are generated from fixture data. The rule above
# exists to keep third-party PII out of the repo; a golden built from three
# invented numbers and a made-up tenant carries none, and a golden that cannot
# be committed is not a golden at all.
!app/test/**/goldens/*.pdf
