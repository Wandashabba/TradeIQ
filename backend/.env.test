DATABASE_URL="postgresql://tradeiq:tradeiq_dev@localhost:5432/tradeiq_test?schema=public"
JWT_SECRET="dev-only-change-me"
PORT=4001

# The assistant route suite drives many chat and artifact requests as one user,
# and the per-user default (20/min) had become a ceiling on the TESTS rather
# than on anything under test — the next route test added anywhere in the file
# failed an unrelated one with a 429. The limiters themselves are covered by
# rateLimit.assistant.test.ts, which builds them with explicit options and does
# not read this.
ASSISTANT_USER_RATE_MAX=200
