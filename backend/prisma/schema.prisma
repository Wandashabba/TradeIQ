generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  field_agent
  manager
  admin
}

enum VisitStatus {
  in_progress
  submitted
}

enum TaskPriority {
  critical
  high
  normal
}

enum TaskStatus {
  open
  in_progress
  closed
}

model Client {
  id                 String              @id @default(uuid())
  name               String
  industry           String
  scorecardWeights   Json                @map("scorecard_weights")
  kpiThresholds      Json                @map("kpi_thresholds")
  /// Conversational assistant rollout flag. Defaults false: the assistant ships
  /// alongside the existing console, never in place of it, and no client gets it
  /// without a deliberate opt-in. Off is a true kill switch — Phases 0-2 mutate
  /// nothing, so degrading to today's dashboard loses no data.
  assistantEnabled   Boolean             @default(false) @map("assistant_enabled")
  users              User[]
  outlets            Outlet[]
  skus               Sku[]
  promoCalendar      PromoCalendar[]
  visits             Visit[]
  territories        Territory[]
  campaigns          Campaign[]
  beatPlans          BeatPlan[]
  alertRules         AlertRule[]
  alerts             Alert[]
  auditTemplates     AuditTemplate[]
  checkInAttempts    CheckInAttempt[]
  orders             Order[]
  messages           Message[]
  announcements      Announcement[]
  webhooks           Webhook[]
  reportDefinitions  ReportDefinition[]
  incentiveSchemes   IncentiveScheme[]
  reportSchedules    ReportSchedule[]
  assistantArtifacts AssistantArtifact[]
  assistantActions   AssistantAction[]
  photos             Photo[]

  @@map("clients")
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  // What people call this person ("Sipho Ndlovu"). Nullable on purpose: rows
  // that predate it have nothing to backfill from but the email local-part, and
  // guessing a name from that is wrong often enough to be worse than blank
  // (#280). Display falls back to `email` when it is null.
  displayName      String?          @map("display_name")
  passwordHash     String           @map("password_hash")
  role             UserRole
  clientId         String           @map("client_id")
  client           Client           @relation(fields: [clientId], references: [id])
  // Deactivated users keep their history but cannot log in (admin provisioning).
  active           Boolean          @default(true)
  // Last-known agent location (updated on check-in) — feeds predictive dispatch.
  lastLat          Float?           @map("last_lat")
  lastLng          Float?           @map("last_lng")
  lastSeenAt       DateTime?        @map("last_seen_at")
  visits           Visit[]
  tasksOwned       Task[]
  territories      UserTerritory[]
  beatPlans        BeatPlan[]
  checkInAttempts  CheckInAttempt[]
  ordersTaken      Order[]
  messagesSent     Message[]        @relation("MessageSender")
  messagesReceived Message[]        @relation("MessageRecipient")
  announcements    Announcement[]
  photosUploaded   Photo[]          @relation("PhotoUploader")

  @@index([clientId, role])
  @@map("users")
}

model Outlet {
  id              String           @id @default(uuid())
  name            String
  code            String
  channelType     String           @map("channel_type")
  lat             Float
  lng             Float
  territoryId     String           @map("territory_id")
  teamProfile     Json?            @map("team_profile")
  /// The outlet's share of category turnover — the ACV weight that makes
  /// *weighted* distribution mean something different from *numeric*
  /// distribution. Defaults to 1, in which case the two metrics agree, which is
  /// honest: with no weights supplied, every outlet genuinely counts the same.
  acvWeight       Float            @default(1) @map("acv_weight")
  clientId        String           @map("client_id")
  client          Client           @relation(fields: [clientId], references: [id])
  visits          Visit[]
  tasks           Task[]
  campaignOutlets CampaignOutlet[]
  beatPlanStops   BeatPlanStop[]
  checkInAttempts CheckInAttempt[]
  orders          Order[]

  // Per-tenant, not global. A globally-unique code meant one tenant creating
  // 'SAN-001' made that code permanently unavailable to every other tenant —
  // and the 409 told them somebody else already had it, which is a
  // cross-tenant existence oracle. Territory already models it this way.
  @@unique([clientId, code])
  @@index([clientId])
  @@index([territoryId])
  @@map("outlets")
}

model Sku {
  id                 String         @id @default(uuid())
  clientId           String         @map("client_id")
  client             Client         @relation(fields: [clientId], references: [id])
  name               String
  category           String
  minFacingsStandard Int            @map("min_facings_standard")
  rrp                Float
  visitStock         VisitStock[]
  visitPricing       VisitPricing[]
  orderLines         OrderLine[]

  @@index([clientId])
  @@map("skus")
}

model PromoCalendar {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  client        Client   @relation(fields: [clientId], references: [id])
  promoName     String   @map("promo_name")
  activeFrom    DateTime @map("active_from")
  activeTo      DateTime @map("active_to")
  requiredPosm  Json     @map("required_posm")
  outletScope   Json     @map("outlet_scope")
  discountType  String?  @map("discount_type") // 'percent' | 'fixed'
  discountValue Float?   @map("discount_value")
  skuScope      Json?    @map("sku_scope") // { skuIds: string[] } | null (null = every SKU)

  @@index([clientId])
  @@map("promo_calendar")
}

model Visit {
  id                String      @id @default(uuid())
  outletId          String      @map("outlet_id")
  outlet            Outlet      @relation(fields: [outletId], references: [id])
  agentId           String      @map("agent_id")
  agent             User        @relation(fields: [agentId], references: [id])
  clientId          String      @map("client_id")
  client            Client      @relation(fields: [clientId], references: [id])
  checkinTs         DateTime    @map("checkin_ts")
  checkinLat        Float       @map("checkin_lat")
  checkinLng        Float       @map("checkin_lng")
  geofencePass      Boolean     @map("geofence_pass")
  checkinDistanceM  Float?      @map("checkin_distance_m")
  status            VisitStatus @default(in_progress)
  /// When the agent's DEVICE says the visit was completed.
  ///
  /// Dwell time (the fraud engine's fast-completion signal) is only meaningful
  /// when measured on ONE clock. `checkinTs` is the device's clock; a section
  /// row's `createdAt` is the server's insert time, which on an offline-first
  /// app is whenever the outbox happened to flush. Subtracting one from the
  /// other measured network conditions and clock skew, not how long the agent
  /// spent in the store (#101).
  ///
  /// Nullable: visits recorded before this existed have no honest dwell, and we
  /// would rather report nothing than a number we know to be wrong.
  submittedAtClient DateTime?   @map("submitted_at_client")

  stock       VisitStock[]
  visibility  VisitVisibility?
  pricing     VisitPricing[]
  competitive VisitCompetitive[]
  capability  VisitCapability?
  risks       VisitRisk[]
  tasks       Task[]
  photos      Photo[]
  scorecard   Scorecard?
  orders      Order[]

  templateResponses VisitTemplateResponse[]

  @@index([clientId, status])
  @@index([clientId, checkinTs])
  @@index([outletId])
  @@index([agentId])
  @@map("visits")
}

model VisitStock {
  id                    String   @id @default(uuid())
  visitId               String   @map("visit_id")
  visit                 Visit    @relation(fields: [visitId], references: [id])
  skuId                 String   @map("sku_id")
  sku                   Sku      @relation(fields: [skuId], references: [id])
  unitsAvailable        Int      @map("units_available")
  lastStockinDate       DateTime @map("last_stockin_date")
  daysOutOfStock        Int      @map("days_out_of_stock")
  velocityAvg           Float    @map("velocity_avg")
  coverageDaysPredicted Float    @map("coverage_days_predicted")
  salesActual           Float?   @map("sales_actual")
  salesTarget           Float?   @map("sales_target")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@index([skuId])
  @@map("visit_stock")
}

model VisitVisibility {
  id                     String   @id @default(uuid())
  visitId                String   @unique @map("visit_id")
  visit                  Visit    @relation(fields: [visitId], references: [id])
  brandingElements       Json     @map("branding_elements")
  planogramCompliancePct Float    @map("planogram_compliance_pct")
  facingsCount           Json     @map("facings_count")
  highTrafficPass        Boolean  @map("high_traffic_pass")
  cleanlinessScore       Int      @map("cleanliness_score")
  createdAt              DateTime @default(now()) @map("created_at")

  @@map("visit_visibility")
}

model VisitPricing {
  id                     String   @id @default(uuid())
  visitId                String   @map("visit_id")
  visit                  Visit    @relation(fields: [visitId], references: [id])
  skuId                  String   @map("sku_id")
  sku                    Sku      @relation(fields: [skuId], references: [id])
  priceActual            Float    @map("price_actual")
  priceMaster            Float    @map("price_master")
  deviationPct           Float    @map("deviation_pct")
  promoActive            Boolean  @map("promo_active")
  promoMaterialsDetected Json     @map("promo_materials_detected")
  commsRating            Int      @map("comms_rating")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@map("visit_pricing")
}

model VisitCompetitive {
  id                        String   @id @default(uuid())
  visitId                   String   @map("visit_id")
  visit                     Visit    @relation(fields: [visitId], references: [id])
  competitorSku             String   @map("competitor_sku")
  competitorPrice           Float    @map("competitor_price")
  competitorPosmType        String   @map("competitor_posm_type")
  competitorPromoterPresent Boolean  @map("competitor_promoter_present")
  /// How many facings this competitor SKU holds. Without it, share-of-shelf was
  /// counting each captured ROW as one facing — so a competitor with a whole
  /// shelf counted the same as one with a single can.
  ///
  /// Defaults to 1 so rows written before this column behave exactly as they did
  /// (one row = one facing) rather than silently changing historic numbers.
  facingsCount              Int      @default(1) @map("facings_count")
  geotag                    Json
  createdAt                 DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@map("visit_competitive")
}

model VisitCapability {
  id                      String   @id @default(uuid())
  visitId                 String   @unique @map("visit_id")
  visit                   Visit    @relation(fields: [visitId], references: [id])
  staffHeadcountConfirmed Int      @map("staff_headcount_confirmed")
  repTrainingStatus       Json     @map("rep_training_status")
  quizScore               Int      @map("quiz_score")
  createdAt               DateTime @default(now()) @map("created_at")

  @@map("visit_capability")
}

model VisitRisk {
  id        String   @id @default(uuid())
  visitId   String   @map("visit_id")
  visit     Visit    @relation(fields: [visitId], references: [id])
  flagType  String   @map("flag_type")
  severity  String
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@map("visit_risks")
}

model Task {
  id              String       @id @default(uuid())
  visitId         String?      @map("visit_id")
  visit           Visit?       @relation(fields: [visitId], references: [id])
  findingType     String       @map("finding_type")
  outletId        String       @map("outlet_id")
  outlet          Outlet       @relation(fields: [outletId], references: [id])
  requiredFix     String       @map("required_fix")
  priority        TaskPriority
  slaDueAt        DateTime     @map("sla_due_at")
  ownerId         String       @map("owner_id")
  owner           User         @relation(fields: [ownerId], references: [id])
  status          TaskStatus   @default(open)
  closurePhotoUrl String?      @map("closure_photo_url")
  closureVerified Boolean      @default(false) @map("closure_verified")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([ownerId, status])
  @@index([outletId])
  @@index([visitId])
  @@map("tasks")
}

/// A stored image (ADR 0007: a base64 data URL in `url`).
///
/// Two kinds share this one pipeline, told apart by `visitId`:
/// * **Visit evidence** — `visitId` set, uploaded by the visit's agent during an
///   audit. Tenant-scoped through photo -> visit -> clientId, as it always was.
/// * **Message attachment** (#125) — `visitId` null, `section`
///   `message_attachment`, owned directly by `clientId` + `uploadedById`, and
///   linked to a message through `MessageAttachment`.
///
/// `clientId` and `uploadedById` are nullable only because rows that predate
/// them have nothing to backfill from here; every new upload sets both.
///
/// Every relation is `Restrict` explicitly. An optional relation would default
/// to SET NULL, and deleting a visit must keep failing while it has evidence —
/// silently turning visit evidence into an unowned, visit-less photo is not a
/// behaviour change this schema should make by accident.
model Photo {
  id                String             @id @default(uuid())
  visitId           String?            @map("visit_id")
  visit             Visit?             @relation(fields: [visitId], references: [id], onDelete: Restrict)
  clientId          String?            @map("client_id")
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  uploadedById      String?            @map("uploaded_by_id")
  uploadedBy        User?              @relation("PhotoUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  section           String
  url               String
  gpsTag            Json               @map("gps_tag")
  timestamp         DateTime
  createdAt         DateTime           @default(now()) @map("created_at")
  messageAttachment MessageAttachment?

  @@index([visitId])
  @@index([clientId])
  @@map("photos")
}

model Scorecard {
  id              String   @id @default(uuid())
  visitId         String   @unique @map("visit_id")
  visit           Visit    @relation(fields: [visitId], references: [id])
  dimensionScores Json     @map("dimension_scores")
  weightedTotal   Float    @map("weighted_total")
  ratingBand      String   @map("rating_band")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("scorecards")
}

// ── Phase 3 (Activation) ──────────────────────────────────────────────────

/// A sales/coverage territory. `code` mirrors the free-text `Outlet.territoryId`
/// so existing outlets link by code without a schema migration on Outlet.
model Territory {
  id          String          @id @default(uuid())
  clientId    String          @map("client_id")
  client      Client          @relation(fields: [clientId], references: [id])
  name        String
  code        String
  region      String?
  createdAt   DateTime        @default(now()) @map("created_at")
  assignments UserTerritory[]
  beatPlans   BeatPlan[]

  @@unique([clientId, code])
  @@map("territories")
}

/// Assigns an agent (User) to a Territory they cover.
model UserTerritory {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  territoryId String    @map("territory_id")
  territory   Territory @relation(fields: [territoryId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([userId, territoryId])
  @@map("user_territories")
}

/// A trade-marketing campaign/promotion activated across a set of outlets.
model Campaign {
  id        String           @id @default(uuid())
  clientId  String           @map("client_id")
  client    Client           @relation(fields: [clientId], references: [id])
  name      String
  objective String?
  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  budget    Float?
  status    String           @default("draft") // draft | active | completed
  createdAt DateTime         @default(now()) @map("created_at")
  outlets   CampaignOutlet[]
  orders    Order[]

  @@index([clientId])
  @@map("campaigns")
}

model CampaignOutlet {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  outletId   String   @map("outlet_id")
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([campaignId, outletId])
  @@map("campaign_outlets")
}

/// A permanent-journey-plan / beat: an agent's scheduled sequence of outlet
/// stops for a day, with per-stop adherence tracking.
model BeatPlan {
  id            String         @id @default(uuid())
  clientId      String         @map("client_id")
  client        Client         @relation(fields: [clientId], references: [id])
  agentId       String         @map("agent_id")
  agent         User           @relation(fields: [agentId], references: [id])
  territoryId   String?        @map("territory_id")
  territory     Territory?     @relation(fields: [territoryId], references: [id])
  name          String
  scheduledDate DateTime       @map("scheduled_date")
  status        String         @default("planned") // planned | in_progress | completed
  createdAt     DateTime       @default(now()) @map("created_at")
  stops         BeatPlanStop[]

  /// Every occurrence generated from one recurrence shares this id, so a series
  /// can be listed or cancelled as a unit. Null for a one-off plan.
  ///
  /// Occurrences are real rows rather than a rule expanded on read because
  /// `BeatPlanStop.visited` is per-occurrence state — there is nowhere to record
  /// "today's third stop was visited" against a computed date.
  seriesId String? @map("series_id")

  /// The rule the series was generated from — `{frequency, interval, daysOfWeek,
  /// until}`. Denormalised onto every occurrence so a screen can say "repeats
  /// weekly" without a second query. Read for display only: the dates are
  /// already materialised, so nothing re-derives them from this.
  recurrence Json?

  @@index([clientId])
  @@index([agentId])
  @@index([seriesId])
  @@map("beat_plans")
}

model BeatPlanStop {
  id         String   @id @default(uuid())
  beatPlanId String   @map("beat_plan_id")
  beatPlan   BeatPlan @relation(fields: [beatPlanId], references: [id])
  outletId   String   @map("outlet_id")
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  sequence   Int
  visited    Boolean  @default(false)

  @@map("beat_plan_stops")
}

/// A configurable rule that raises Alerts from audit exceptions.
model AlertRule {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  metric    String // out_of_stock | price_deviation | low_scorecard | sla_breach
  threshold Float?
  severity  String   @default("normal")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  alerts    Alert[]

  @@index([clientId])
  @@map("alert_rules")
}

/// A raised alert instance (an exception that matched an AlertRule).
model Alert {
  id           String     @id @default(uuid())
  clientId     String     @map("client_id")
  client       Client     @relation(fields: [clientId], references: [id])
  ruleId       String?    @map("rule_id")
  rule         AlertRule? @relation(fields: [ruleId], references: [id])
  visitId      String?    @map("visit_id")
  outletId     String?    @map("outlet_id")
  metric       String
  message      String
  severity     String
  acknowledged Boolean    @default(false)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([clientId, acknowledged])
  @@map("alerts")
}

/// A configurable, versioned audit/survey template (dynamic form definition)
/// per client/industry. `schema` is the form JSON (sections/fields/conditions/
/// scoring); rendering/validation of it is an app-side concern.
model AuditTemplate {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  industry  String?
  schema    Json
  version   Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  responses VisitTemplateResponse[]

  @@map("audit_templates")
}

/// A visit's answers to a dynamic audit template — the generic persistence
/// model for template-driven (non-S1–S10) capture. One row per
/// (visit, template); re-submitting a section overwrites the answers.
/// `templateVersion` snapshots the template version answered against, since a
/// schema patch bumps AuditTemplate.version.
model VisitTemplateResponse {
  id              String        @id @default(uuid())
  visitId         String        @map("visit_id")
  visit           Visit         @relation(fields: [visitId], references: [id])
  templateId      String        @map("template_id")
  template        AuditTemplate @relation(fields: [templateId], references: [id])
  templateVersion Int           @map("template_version")
  answers         Json
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([visitId, templateId])
  @@map("visit_template_responses")
}

// ── Phase 2 (Intelligence) + Phase 3 (Activation) Tier-2 ──────────────────

/// Every geofenced check-in attempt, including rejected/borderline ones that
/// never became a Visit — the negative-signal dataset for fraud/ghost-visit
/// detection.
model CheckInAttempt {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  outletId  String   @map("outlet_id")
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  agentId   String   @map("agent_id")
  agent     User     @relation(fields: [agentId], references: [id])
  lat       Float
  lng       Float
  distanceM Float    @map("distance_m")
  passed    Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, passed])
  @@index([agentId, outletId])
  @@map("check_in_attempts")
}

/// An in-visit order / sell-in captured by an agent (Phase 3 #36).
model Order {
  id       String  @id @default(uuid())
  clientId String  @map("client_id")
  client   Client  @relation(fields: [clientId], references: [id])
  outletId String  @map("outlet_id")
  outlet   Outlet  @relation(fields: [outletId], references: [id])
  agentId  String  @map("agent_id")
  agent    User    @relation(fields: [agentId], references: [id])
  visitId  String? @map("visit_id")

  /// The campaign this order is attributed to, stamped at creation when the
  /// outlet was in an active campaign's window. Nullable and never back-filled:
  /// an order placed outside any campaign genuinely belongs to none, and
  /// re-attributing later would silently rewrite a campaign's measured return.
  campaignId String?     @map("campaign_id")
  campaign   Campaign?   @relation(fields: [campaignId], references: [id])
  visit      Visit?      @relation(fields: [visitId], references: [id])
  status     String      @default("submitted") // submitted | confirmed | cancelled
  total      Float       @default(0)
  createdAt  DateTime    @default(now()) @map("created_at")
  lines      OrderLine[]

  @@index([clientId])
  @@map("orders")
}

model OrderLine {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  order     Order  @relation(fields: [orderId], references: [id])
  skuId     String @map("sku_id")
  sku       Sku    @relation(fields: [skuId], references: [id])
  quantity  Int
  unitPrice Float  @map("unit_price")

  @@map("order_lines")
}

/// Direct/group field message (Phase 3 #37). `recipientId` null = broadcast
/// within the client.
model Message {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  client      Client    @relation(fields: [clientId], references: [id])
  senderId    String    @map("sender_id")
  sender      User      @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String?   @map("recipient_id")
  recipient   User?     @relation("MessageRecipient", fields: [recipientId], references: [id])
  body        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  attachments MessageAttachment[]

  @@index([clientId])
  @@index([recipientId])
  @@map("messages")
}

/// An image attached to a message (#125).
///
/// IMAGES ONLY, by design: attachments reuse the existing photo pipeline
/// (`POST /photos`, base64 in Postgres per ADR 0007, and its thumbnail route)
/// rather than a general-purpose file store. There is no PDF or arbitrary-file
/// support — that would need real object storage first.
///
/// `photoId` is unique: a photo is attached to at most one message, so the
/// access grant an attachment confers (see photos.service) has exactly one
/// source. A message carries at most MAX_MESSAGE_ATTACHMENTS (4), in
/// `position` order.
model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  photoId   String   @unique @map("photo_id")
  photo     Photo    @relation(fields: [photoId], references: [id])
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("message_attachments")
}

/// A broadcast announcement to the client's field team (Phase 3 #37).
model Announcement {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("announcements")
}

/// An outbound webhook subscription (Phase 3 #38). Fired on matching events
/// (e.g. visit.submitted, order.created, alert.raised).
model Webhook {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  url       String
  event     String
  secret    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  /// Health (#100). Deliveries that gave up since the last success. Reset to 0
  /// by any successful delivery; the webhook reads as unhealthy while > 0.
  consecutiveFailures Int                   @default(0) @map("consecutive_failures")
  /// The outcome and time of the most recent delivery attempt, stored rather
  /// than derived: the list endpoint would otherwise need the newest delivery
  /// per webhook, and Prisma paginates nested relations in memory.
  lastDeliveryStatus  WebhookDeliveryStatus? @map("last_delivery_status")
  lastDeliveryAt      DateTime?             @map("last_delivery_at")
  deliveries          WebhookDelivery[]

  @@index([clientId, event, active])
  @@map("webhooks")
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  failed_retrying
  gave_up
}

/// One event delivered to one webhook (#100) — the outbox row that makes the
/// fan-out retryable and auditable. The payload is the exact envelope sent, so
/// every retry re-sends the same body; only the signature timestamp changes.
model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookId      String                @map("webhook_id")
  webhook        Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  /// Denormalised from the webhook so the deliveries endpoint scopes by tenant
  /// without a join.
  clientId       String                @map("client_id")
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  lastStatusCode Int?                  @map("last_status_code")
  lastError      String?               @map("last_error")
  /// When the row is next due. Also the claim lease: a processor that takes a
  /// row pushes this forward, so nobody else picks it up mid-attempt.
  nextAttemptAt  DateTime?             @map("next_attempt_at")
  lastAttemptAt  DateTime?             @map("last_attempt_at")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

/// A saved report definition (Phase 3 #39) — a named, filtered report the
/// manager can generate on demand (scheduled delivery is a follow-up).
model ReportDefinition {
  id        String           @id @default(uuid())
  clientId  String           @map("client_id")
  client    Client           @relation(fields: [clientId], references: [id])
  name      String
  type      String // visits | scorecards | tasks | orders
  filters   Json
  createdAt DateTime         @default(now()) @map("created_at")
  schedules ReportSchedule[]

  @@index([clientId])
  @@map("report_definitions")
}

/// A reward scheme that turns field performance into agent incentives
/// (Phase 3 #34, the reward side of gamification).
model IncentiveScheme {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  client       Client   @relation(fields: [clientId], references: [id])
  name         String
  metric       String // scorecard | tasks_closed | visits
  threshold    Float
  rewardPoints Int      @map("reward_points")
  rewardDetail String?  @map("reward_detail")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clientId, active])
  @@map("incentive_schemes")
}

/// A recurring delivery of a saved report (Phase 3 #39). The scheduler that
/// fires these is infra (Phase 4); this model + the run endpoint are the seam.
model ReportSchedule {
  id                 String           @id @default(uuid())
  clientId           String           @map("client_id")
  client             Client           @relation(fields: [clientId], references: [id])
  reportDefinitionId String           @map("report_definition_id")
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id])
  cadence            String // daily | weekly
  recipients         Json
  lastRunAt          DateTime?        @map("last_run_at")
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([clientId])
  @@map("report_schedules")
}

/// A persisted, refinable view produced by a tool call in an assistant turn.
///
/// **Stores what to re-run, never what was returned.** The row carries the tool
/// name and its parameters; the data is fetched fresh on every read by invoking
/// that tool again through the caller's own roster. Caching the result here
/// would create a second copy of tenant data with its own staleness and its own
/// access-control story — the thing the tool closure exists to avoid.
///
/// `userId` scopes an artifact to the person whose conversation produced it.
/// Tenant scoping alone would let one manager refine a colleague's artifact,
/// which is not a data leak (the roster still re-authorises every run) but is
/// someone else's workspace.
model AssistantArtifact {
  id             String   @id @default(uuid())
  clientId       String   @map("client_id")
  client         Client   @relation(fields: [clientId], references: [id])
  userId         String   @map("user_id")
  conversationId String   @map("conversation_id")
  /// The view-spec type from the closed catalog — `trend_chart`, `outlet_map`, …
  type           String
  toolName       String   @map("tool_name")
  params         Json
  /// Previous params, oldest first, for undo. Capped in the service layer.
  paramsHistory  Json     @default("[]") @map("params_history")
  /// Set when the USER moved a control, cleared once a turn has told the model.
  /// Non-null means the model's picture of this view is stale — it is reasoning
  /// from whatever params it last saw, which is no longer what is on screen.
  /// A timestamp rather than a boolean so the notes can be ordered when several
  /// views moved between two turns.
  paramsChangedAt DateTime? @map("params_changed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([clientId, userId, conversationId])
  @@map("assistant_artifacts")
}

/// Every write the assistant attempted — including the ones it was not allowed
/// to make.
///
/// **A ledger, not a log.** Rows are written before the action runs and updated
/// with its outcome, so an action that crashed mid-flight leaves a row saying
/// so rather than leaving no trace. "No row" therefore means "never attempted",
/// which is the property that makes this answerable in an incident.
///
/// Refusals are recorded for the same reason: a tenant asking for something it
/// cannot have is the signal worth keeping, and a ledger of successes only
/// cannot distinguish "nobody tried" from "somebody tried repeatedly".
model AssistantAction {
  id             String   @id @default(uuid())
  clientId       String   @map("client_id")
  client         Client   @relation(fields: [clientId], references: [id])
  /// Who asked. Not a relation: a user may be deleted and the ledger must
  /// outlive them, which is the whole point of an audit trail.
  userId         String   @map("user_id")
  conversationId String?  @map("conversation_id")
  toolName       String   @map("tool_name")
  /// The tier AT THE TIME. Denormalised on purpose — re-deriving it from
  /// risk.ts when the ledger is read would rewrite history every time the
  /// policy table changes, and "what did we consider risky then" is exactly
  /// what an auditor asks.
  tier           String
  /// The validated arguments, as the tool's own schema returned them. Never
  /// the model's raw text — the point of comparison later is what RAN.
  args           Json
  /// requested · awaiting_confirmation · executed · refused · rejected · failed
  outcome        String
  /// Why, when the outcome was refused, rejected or failed. Null otherwise.
  detail         String?
  /// What an undo would need for a `reversible` action — the created row's id,
  /// the previous value. Null for tiers that cannot be undone this way.
  undoContext    Json?    @map("undo_context")
  createdAt      DateTime @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  /// The audit view filters by tenant and orders by time; the second index
  /// serves "everything this person did", which is the first question asked
  /// when something looks wrong.
  @@index([clientId, createdAt])
  @@index([clientId, userId, createdAt])
  @@map("assistant_actions")
}
