generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  field_agent
  manager
  admin
}

enum VisitStatus {
  in_progress
  submitted
}

enum TaskPriority {
  critical
  high
  normal
}

enum TaskStatus {
  open
  in_progress
  closed
}

model Client {
  id                 String                   @id @default(uuid())
  name               String
  industry           String
  scorecardWeights   Json                     @map("scorecard_weights")
  kpiThresholds      Json                     @map("kpi_thresholds")
  /// Conversational assistant rollout flag. Defaults false: the assistant ships
  /// alongside the existing console, never in place of it, and no client gets it
  /// without a deliberate opt-in. Off is a true kill switch — Phases 0-2 mutate
  /// nothing, so degrading to today's dashboard loses no data.
  assistantEnabled   Boolean                  @default(false) @map("assistant_enabled")
  /// IANA zone the client's field team works in (#309). Every calendar-day
  /// rule reads it: which beat plan a check-in belongs to, trend day/week
  /// buckets, and the assistant's "today"/"last week". Validated against the
  /// runtime's IANA list on write; editable by managers and admins.
  timezone           String                   @default("Africa/Johannesburg")
  users              User[]
  outlets            Outlet[]
  skus               Sku[]
  promoCalendar      PromoCalendar[]
  visits             Visit[]
  territories        Territory[]
  campaigns          Campaign[]
  beatPlans          BeatPlan[]
  alertRules         AlertRule[]
  alerts             Alert[]
  auditTemplates     AuditTemplate[]          @relation("ClientAuditTemplates")
  checkInAttempts    CheckInAttempt[]
  orders             Order[]
  messages           Message[]
  announcements      Announcement[]
  webhooks           Webhook[]
  reportDefinitions  ReportDefinition[]
  incentiveSchemes   IncentiveScheme[]
  reportSchedules    ReportSchedule[]
  assistantArtifacts AssistantArtifact[]
  assistantActions   AssistantAction[]
  photos             Photo[]
  pointsLedger       PointsLedgerEntry[]
  locationPings      AgentLocationPing[]
  agentDaySummaries  AgentDaySummary[]
  locationConsents   LocationConsent[]
  contests           Contest[]
  deviceTokens       DeviceToken[]
  notificationPrefs  NotificationPreference[]
  salesTargets       SalesTarget[]

  /// The audit template whose questions field agents answer on every visit, as
  /// an extra section after the fixed S1–S10 (#122). It SUPPLEMENTS the fixed
  /// sections and never feeds the perfect-store score. Null = no client
  /// questions. Must be one of this client's own templates (enforced in
  /// templates.service); pausing the template clears it, deleting it nulls it.
  auditTemplateId String?        @unique @map("audit_template_id")
  auditTemplate   AuditTemplate? @relation("ClientSelectedAuditTemplate", fields: [auditTemplateId], references: [id], onDelete: SetNull)

  @@map("clients")
}

model User {
  id                String                   @id @default(uuid())
  email             String                   @unique
  // What people call this person ("Sipho Ndlovu"). Nullable on purpose: rows
  // that predate it have nothing to backfill from but the email local-part, and
  // guessing a name from that is wrong often enough to be worse than blank
  // (#280). Display falls back to `email` when it is null.
  displayName       String?                  @map("display_name")
  passwordHash      String                   @map("password_hash")
  role              UserRole
  clientId          String                   @map("client_id")
  client            Client                   @relation(fields: [clientId], references: [id])
  // Deactivated users keep their history but cannot log in (admin provisioning).
  active            Boolean                  @default(true)
  // Last-known agent location (updated on check-in) — feeds predictive dispatch.
  lastLat           Float?                   @map("last_lat")
  lastLng           Float?                   @map("last_lng")
  lastSeenAt        DateTime?                @map("last_seen_at")
  visits            Visit[]
  tasksOwned        Task[]
  territories       UserTerritory[]
  beatPlans         BeatPlan[]
  checkInAttempts   CheckInAttempt[]
  ordersTaken       Order[]
  messagesSent      Message[]                @relation("MessageSender")
  messagesReceived  Message[]                @relation("MessageRecipient")
  announcements     Announcement[]
  photosUploaded    Photo[]                  @relation("PhotoUploader")
  pointsLedger      PointsLedgerEntry[]
  locationPings     AgentLocationPing[]
  daySummaries      AgentDaySummary[]
  locationConsents  LocationConsent[]
  deviceTokens      DeviceToken[]
  notificationPrefs NotificationPreference[]
  salesTargetsSet   SalesTarget[]
  contestsCreated   Contest[]                @relation("ContestCreator")

  @@index([clientId, role])
  @@map("users")
}

model Outlet {
  id              String           @id @default(uuid())
  name            String
  code            String
  channelType     String           @map("channel_type")
  lat             Float
  lng             Float
  territoryId     String           @map("territory_id")
  teamProfile     Json?            @map("team_profile")
  /// The outlet's share of category turnover — the ACV weight that makes
  /// *weighted* distribution mean something different from *numeric*
  /// distribution. Defaults to 1, in which case the two metrics agree, which is
  /// honest: with no weights supplied, every outlet genuinely counts the same.
  acvWeight       Float            @default(1) @map("acv_weight")
  clientId        String           @map("client_id")
  client          Client           @relation(fields: [clientId], references: [id])
  visits          Visit[]
  tasks           Task[]
  campaignOutlets CampaignOutlet[]
  beatPlanStops   BeatPlanStop[]
  checkInAttempts CheckInAttempt[]
  orders          Order[]
  salesTargets    SalesTarget[]

  // Per-tenant, not global. A globally-unique code meant one tenant creating
  // 'SAN-001' made that code permanently unavailable to every other tenant —
  // and the 409 told them somebody else already had it, which is a
  // cross-tenant existence oracle. Territory already models it this way.
  @@unique([clientId, code])
  @@index([clientId])
  @@index([territoryId])
  @@map("outlets")
}

model Sku {
  id                 String         @id @default(uuid())
  clientId           String         @map("client_id")
  client             Client         @relation(fields: [clientId], references: [id])
  name               String
  category           String
  minFacingsStandard Int            @map("min_facings_standard")
  rrp                Float
  visitStock         VisitStock[]
  visitPricing       VisitPricing[]
  orderLines         OrderLine[]
  salesTargets       SalesTarget[]

  @@index([clientId])
  @@map("skus")
}

model PromoCalendar {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  client        Client   @relation(fields: [clientId], references: [id])
  promoName     String   @map("promo_name")
  activeFrom    DateTime @map("active_from")
  activeTo      DateTime @map("active_to")
  requiredPosm  Json     @map("required_posm")
  outletScope   Json     @map("outlet_scope")
  discountType  String?  @map("discount_type") // 'percent' | 'fixed'
  discountValue Float?   @map("discount_value")
  skuScope      Json?    @map("sku_scope") // { skuIds: string[] } | null (null = every SKU)

  @@index([clientId])
  @@map("promo_calendar")
}

model Visit {
  id                String      @id @default(uuid())
  outletId          String      @map("outlet_id")
  outlet            Outlet      @relation(fields: [outletId], references: [id])
  agentId           String      @map("agent_id")
  agent             User        @relation(fields: [agentId], references: [id])
  clientId          String      @map("client_id")
  client            Client      @relation(fields: [clientId], references: [id])
  checkinTs         DateTime    @map("checkin_ts")
  checkinLat        Float       @map("checkin_lat")
  checkinLng        Float       @map("checkin_lng")
  geofencePass      Boolean     @map("geofence_pass")
  checkinDistanceM  Float?      @map("checkin_distance_m")
  status            VisitStatus @default(in_progress)
  /// When the agent's DEVICE says the visit was completed.
  ///
  /// Dwell time (the fraud engine's fast-completion signal) is only meaningful
  /// when measured on ONE clock. `checkinTs` is the device's clock; a section
  /// row's `createdAt` is the server's insert time, which on an offline-first
  /// app is whenever the outbox happened to flush. Subtracting one from the
  /// other measured network conditions and clock skew, not how long the agent
  /// spent in the store (#101).
  ///
  /// Nullable: visits recorded before this existed have no honest dwell, and we
  /// would rather report nothing than a number we know to be wrong.
  submittedAtClient DateTime?   @map("submitted_at_client")

  /// The fraud engine's result for this visit, stored so GET /fraud/flagged can
  /// filter and sort on a column and paginate like every other list (#236).
  ///
  /// A SNAPSHOT, not a live value. It is computed when the visit is submitted
  /// (and by `npm run rescore-fraud`), and several signals read history that can
  /// change afterwards: earlier visits' stock and photos, rejected check-in
  /// attempts, and the client's `kpiThresholds`. `fraudScoredAt` says when it
  /// was taken. GET /fraud/visits/:id always recomputes live; only the flagged
  /// list reads these columns. A client that changes a fraud threshold rescores
  /// with `npm run rescore-fraud -- --client <id> --all`.
  ///
  /// Nullable: visits recorded before #236 have no score until backfilled, and
  /// the flagged list reports how many of those are in range rather than hiding
  /// them silently.
  riskScore     Int?      @map("risk_score")
  /// The FraudSignal[] ({code, detail, weight}) behind `riskScore`.
  fraudSignals  Json?     @map("fraud_signals")
  /// When the stored score's inputs were read.
  fraudScoredAt DateTime? @map("fraud_scored_at")

  stock       VisitStock[]
  visibility  VisitVisibility?
  pricing     VisitPricing[]
  competitive VisitCompetitive[]
  capability  VisitCapability?
  risks       VisitRisk[]
  tasks       Task[]
  photos      Photo[]
  scorecard   Scorecard?
  orders      Order[]

  templateResponses VisitTemplateResponse[]

  @@index([clientId, status])
  @@index([clientId, checkinTs])
  // GET /fraud/flagged (#236): `client_id = ? AND status = 'submitted' AND
  // risk_score >= ?` ordered `risk_score DESC, id DESC` — the equality columns,
  // then exactly the keyset's sort, so a page is an index range read in order
  // with no sort step. Also serves the `risk_score IS NULL` unscored count.
  @@index([clientId, status, riskScore(sort: Desc), id(sort: Desc)])
  @@index([outletId])
  @@index([agentId])
  @@map("visits")
}

model VisitStock {
  id                    String   @id @default(uuid())
  visitId               String   @map("visit_id")
  visit                 Visit    @relation(fields: [visitId], references: [id])
  skuId                 String   @map("sku_id")
  sku                   Sku      @relation(fields: [skuId], references: [id])
  unitsAvailable        Int      @map("units_available")
  lastStockinDate       DateTime @map("last_stockin_date")
  daysOutOfStock        Int      @map("days_out_of_stock")
  velocityAvg           Float    @map("velocity_avg")
  coverageDaysPredicted Float    @map("coverage_days_predicted")
  salesActual           Float?   @map("sales_actual")
  salesTarget           Float?   @map("sales_target")
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@index([skuId])
  @@map("visit_stock")
}

model VisitVisibility {
  id                     String   @id @default(uuid())
  visitId                String   @unique @map("visit_id")
  visit                  Visit    @relation(fields: [visitId], references: [id])
  brandingElements       Json     @map("branding_elements")
  planogramCompliancePct Float    @map("planogram_compliance_pct")
  facingsCount           Json     @map("facings_count")
  highTrafficPass        Boolean  @map("high_traffic_pass")
  cleanlinessScore       Int      @map("cleanliness_score")
  createdAt              DateTime @default(now()) @map("created_at")

  @@map("visit_visibility")
}

model VisitPricing {
  id                     String   @id @default(uuid())
  visitId                String   @map("visit_id")
  visit                  Visit    @relation(fields: [visitId], references: [id])
  skuId                  String   @map("sku_id")
  sku                    Sku      @relation(fields: [skuId], references: [id])
  priceActual            Float    @map("price_actual")
  priceMaster            Float    @map("price_master")
  deviationPct           Float    @map("deviation_pct")
  promoActive            Boolean  @map("promo_active")
  promoMaterialsDetected Json     @map("promo_materials_detected")
  commsRating            Int      @map("comms_rating")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@map("visit_pricing")
}

model VisitCompetitive {
  id                        String   @id @default(uuid())
  visitId                   String   @map("visit_id")
  visit                     Visit    @relation(fields: [visitId], references: [id])
  competitorSku             String   @map("competitor_sku")
  competitorPrice           Float    @map("competitor_price")
  competitorPosmType        String   @map("competitor_posm_type")
  competitorPromoterPresent Boolean  @map("competitor_promoter_present")
  /// How many facings this competitor SKU holds. Without it, share-of-shelf was
  /// counting each captured ROW as one facing — so a competitor with a whole
  /// shelf counted the same as one with a single can.
  ///
  /// Defaults to 1 so rows written before this column behave exactly as they did
  /// (one row = one facing) rather than silently changing historic numbers.
  facingsCount              Int      @default(1) @map("facings_count")
  geotag                    Json
  createdAt                 DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@map("visit_competitive")
}

model VisitCapability {
  id                      String   @id @default(uuid())
  visitId                 String   @unique @map("visit_id")
  visit                   Visit    @relation(fields: [visitId], references: [id])
  staffHeadcountConfirmed Int      @map("staff_headcount_confirmed")
  repTrainingStatus       Json     @map("rep_training_status")
  quizScore               Int      @map("quiz_score")
  createdAt               DateTime @default(now()) @map("created_at")

  @@map("visit_capability")
}

model VisitRisk {
  id        String   @id @default(uuid())
  visitId   String   @map("visit_id")
  visit     Visit    @relation(fields: [visitId], references: [id])
  flagType  String   @map("flag_type")
  severity  String
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@map("visit_risks")
}

model Task {
  id                  String       @id @default(uuid())
  visitId             String?      @map("visit_id")
  visit               Visit?       @relation(fields: [visitId], references: [id])
  findingType         String       @map("finding_type")
  outletId            String       @map("outlet_id")
  outlet              Outlet       @relation(fields: [outletId], references: [id])
  requiredFix         String       @map("required_fix")
  priority            TaskPriority
  slaDueAt            DateTime     @map("sla_due_at")
  ownerId             String       @map("owner_id")
  owner               User         @relation(fields: [ownerId], references: [id])
  status              TaskStatus   @default(open)
  closurePhotoUrl     String?      @map("closure_photo_url")
  closureVerified     Boolean      @default(false) @map("closure_verified")
  createdAt           DateTime     @default(now()) @map("created_at")
  /// When the SLA-breach push (#67) was sent for this task. Set once, by the
  /// breach sweep, so a breach is announced exactly once however many
  /// instances run the sweep. Null = not announced (not breached yet, closed
  /// in time, or breached before push existed).
  slaBreachNotifiedAt DateTime?    @map("sla_breach_notified_at")

  @@index([ownerId, status])
  @@index([slaDueAt])
  @@index([outletId])
  @@index([visitId])
  @@map("tasks")
}

/// A stored image (ADR 0007: a base64 data URL in `url`).
///
/// Two kinds share this one pipeline, told apart by `visitId`:
/// * **Visit evidence** — `visitId` set, uploaded by the visit's agent during an
///   audit. Tenant-scoped through photo -> visit -> clientId, as it always was.
/// * **Message attachment** (#125) — `visitId` null, `section`
///   `message_attachment`, owned directly by `clientId` + `uploadedById`, and
///   linked to a message through `MessageAttachment`.
///
/// `clientId` and `uploadedById` are nullable only because rows that predate
/// them have nothing to backfill from here; every new upload sets both.
///
/// Every relation is `Restrict` explicitly. An optional relation would default
/// to SET NULL, and deleting a visit must keep failing while it has evidence —
/// silently turning visit evidence into an unowned, visit-less photo is not a
/// behaviour change this schema should make by accident.
model Photo {
  id                  String             @id @default(uuid())
  visitId             String?            @map("visit_id")
  visit               Visit?             @relation(fields: [visitId], references: [id], onDelete: Restrict)
  clientId            String?            @map("client_id")
  client              Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  uploadedById        String?            @map("uploaded_by_id")
  uploadedBy          User?              @relation("PhotoUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  section             String
  url                 String
  gpsTag              Json               @map("gps_tag")
  timestamp           DateTime
  createdAt           DateTime           @default(now()) @map("created_at")
  messageAttachment   MessageAttachment?
  /// SHA-256 (hex) of the decoded image bytes, computed at upload (#244).
  /// Null for rows written before it existed until backfilled
  /// (scripts/backfill-photo-hashes.ts), and for payloads that are not a base64
  /// image data URL. Duplicate detection compares THIS, never `url`: a btree
  /// cannot index a multi-MB base64 string (~2704-byte cap).
  contentHash         String?            @map("content_hash")
  /// 64-bit difference hash (dHash) as 16 hex chars, computed at upload (#244).
  /// Survives re-encoding and light cropping, unlike contentHash. Null when the
  /// bytes do not decode as an image.
  perceptualHash      String?            @map("perceptual_hash")
  /// The dHash split into four position-tagged 16-bit bands
  /// (band index << 16 | band value), GIN-indexed so a near-duplicate lookup
  /// probes the index instead of comparing every photo. Empty when there is no
  /// hash or the hash is degenerate (a blank frame) — see photos/photoHash.ts.
  perceptualHashBands Int[]              @default([]) @map("perceptual_hash_bands")

  @@index([visitId])
  @@index([clientId])
  @@index([contentHash])
  // WITH (fastupdate = off), set by migration 20260915090000 (#311): Prisma
  // cannot express index storage parameters. A pending list made every
  // near-duplicate probe scan all recent uploads linearly. Recreating this
  // index by hand must keep it.
  @@index([perceptualHashBands], type: Gin)
  @@map("photos")
}

model Scorecard {
  id              String   @id @default(uuid())
  visitId         String   @unique @map("visit_id")
  visit           Visit    @relation(fields: [visitId], references: [id])
  dimensionScores Json     @map("dimension_scores")
  weightedTotal   Float    @map("weighted_total")
  ratingBand      String   @map("rating_band")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("scorecards")
}

// ── Phase 3 (Activation) ──────────────────────────────────────────────────

/// A sales/coverage territory. `code` mirrors the free-text `Outlet.territoryId`
/// so existing outlets link by code without a schema migration on Outlet.
model Territory {
  id           String          @id @default(uuid())
  clientId     String          @map("client_id")
  client       Client          @relation(fields: [clientId], references: [id])
  name         String
  code         String
  region       String?
  createdAt    DateTime        @default(now()) @map("created_at")
  assignments  UserTerritory[]
  beatPlans    BeatPlan[]
  salesTargets SalesTarget[]
  contests     Contest[]

  @@unique([clientId, code])
  @@map("territories")
}

/// Assigns an agent (User) to a Territory they cover.
model UserTerritory {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  territoryId String    @map("territory_id")
  territory   Territory @relation(fields: [territoryId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([userId, territoryId])
  @@map("user_territories")
}

/// A trade-marketing campaign/promotion activated across a set of outlets.
model Campaign {
  id        String           @id @default(uuid())
  clientId  String           @map("client_id")
  client    Client           @relation(fields: [clientId], references: [id])
  name      String
  objective String?
  startDate DateTime         @map("start_date")
  endDate   DateTime         @map("end_date")
  budget    Float?
  status    String           @default("draft") // draft | active | completed
  createdAt DateTime         @default(now()) @map("created_at")
  outlets   CampaignOutlet[]
  orders    Order[]

  @@index([clientId])
  @@map("campaigns")
}

model CampaignOutlet {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  outletId   String   @map("outlet_id")
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([campaignId, outletId])
  @@map("campaign_outlets")
}

/// A permanent-journey-plan / beat: an agent's scheduled sequence of outlet
/// stops for a day, with per-stop adherence tracking.
model BeatPlan {
  id            String         @id @default(uuid())
  clientId      String         @map("client_id")
  client        Client         @relation(fields: [clientId], references: [id])
  agentId       String         @map("agent_id")
  agent         User           @relation(fields: [agentId], references: [id])
  territoryId   String?        @map("territory_id")
  territory     Territory?     @relation(fields: [territoryId], references: [id])
  name          String
  scheduledDate DateTime       @map("scheduled_date")
  status        String         @default("planned") // planned | in_progress | completed
  createdAt     DateTime       @default(now()) @map("created_at")
  stops         BeatPlanStop[]

  /// Every occurrence generated from one recurrence shares this id, so a series
  /// can be listed or cancelled as a unit. Null for a one-off plan.
  ///
  /// Occurrences are real rows rather than a rule expanded on read because
  /// `BeatPlanStop.visited` is per-occurrence state — there is nowhere to record
  /// "today's third stop was visited" against a computed date.
  seriesId String? @map("series_id")

  /// The rule the series was generated from — `{frequency, interval, daysOfWeek,
  /// until}`. Denormalised onto every occurrence so a screen can say "repeats
  /// weekly" without a second query. Read for display only: the dates are
  /// already materialised, so nothing re-derives them from this.
  recurrence Json?

  @@index([clientId])
  @@index([agentId])
  @@index([seriesId])
  @@map("beat_plans")
}

model BeatPlanStop {
  id         String   @id @default(uuid())
  beatPlanId String   @map("beat_plan_id")
  beatPlan   BeatPlan @relation(fields: [beatPlanId], references: [id])
  outletId   String   @map("outlet_id")
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  sequence   Int
  visited    Boolean  @default(false)

  @@map("beat_plan_stops")
}

/// A configurable rule that raises Alerts from audit exceptions.
model AlertRule {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  metric    String // out_of_stock | price_deviation | low_scorecard | sla_breach
  threshold Float?
  severity  String   @default("normal")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  alerts    Alert[]

  @@index([clientId])
  @@map("alert_rules")
}

/// A raised alert instance (an exception that matched an AlertRule).
model Alert {
  id           String     @id @default(uuid())
  clientId     String     @map("client_id")
  client       Client     @relation(fields: [clientId], references: [id])
  ruleId       String?    @map("rule_id")
  rule         AlertRule? @relation(fields: [ruleId], references: [id])
  visitId      String?    @map("visit_id")
  outletId     String?    @map("outlet_id")
  metric       String
  message      String
  severity     String
  acknowledged Boolean    @default(false)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([clientId, acknowledged])
  @@map("alerts")
}

/// A configurable, versioned audit/survey template (dynamic form definition)
/// per client/industry. `schema` is the form JSON (sections/fields/conditions/
/// scoring); rendering/validation of it is an app-side concern.
model AuditTemplate {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation("ClientAuditTemplates", fields: [clientId], references: [id])
  name      String
  industry  String?
  schema    Json
  version   Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  responses        VisitTemplateResponse[]
  /// The client that uses this template in its field audits, if any (#122).
  selectedByClient Client?                 @relation("ClientSelectedAuditTemplate")

  @@map("audit_templates")
}

/// A visit's answers to a dynamic audit template — the generic persistence
/// model for template-driven (non-S1–S10) capture. One row per
/// (visit, template); re-submitting a section overwrites the answers.
/// `templateVersion` snapshots the template version answered against, since a
/// schema patch bumps AuditTemplate.version.
model VisitTemplateResponse {
  id              String        @id @default(uuid())
  visitId         String        @map("visit_id")
  visit           Visit         @relation(fields: [visitId], references: [id])
  templateId      String        @map("template_id")
  template        AuditTemplate @relation(fields: [templateId], references: [id])
  templateVersion Int           @map("template_version")
  answers         Json
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([visitId, templateId])
  @@map("visit_template_responses")
}

// ── Phase 2 (Intelligence) + Phase 3 (Activation) Tier-2 ──────────────────

/// Every geofenced check-in attempt, including rejected/borderline ones that
/// never became a Visit — the negative-signal dataset for fraud/ghost-visit
/// detection.
model CheckInAttempt {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  outletId  String   @map("outlet_id")
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  agentId   String   @map("agent_id")
  agent     User     @relation(fields: [agentId], references: [id])
  lat       Float
  lng       Float
  distanceM Float    @map("distance_m")
  passed    Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, passed])
  @@index([agentId, outletId])
  @@map("check_in_attempts")
}

/// An in-visit order / sell-in captured by an agent (Phase 3 #36).
model Order {
  id       String  @id @default(uuid())
  clientId String  @map("client_id")
  client   Client  @relation(fields: [clientId], references: [id])
  outletId String  @map("outlet_id")
  outlet   Outlet  @relation(fields: [outletId], references: [id])
  agentId  String  @map("agent_id")
  agent    User    @relation(fields: [agentId], references: [id])
  visitId  String? @map("visit_id")

  /// The campaign this order is attributed to, stamped at creation when the
  /// outlet was in an active campaign's window. Nullable and never back-filled:
  /// an order placed outside any campaign genuinely belongs to none, and
  /// re-attributing later would silently rewrite a campaign's measured return.
  campaignId String?     @map("campaign_id")
  campaign   Campaign?   @relation(fields: [campaignId], references: [id])
  visit      Visit?      @relation(fields: [visitId], references: [id])
  status     String      @default("submitted") // submitted | confirmed | cancelled
  total      Float       @default(0)
  createdAt  DateTime    @default(now()) @map("created_at")

  /// When the DEVICE took the order, as opposed to `createdAt`, which is when
  /// the server received it (#338). An order captured offline at 23:30 on 30
  /// September and synced on 1 October has a `createdAt` in October and a
  /// `capturedAt` in September; September is when it was sold, so this is the
  /// timestamp every "which day/month is this order in" rule reads — sell-in
  /// months and attainment, the forecast's day buckets, and campaign
  /// attribution. `createdAt` stays what it always was and still dates the
  /// things that genuinely mean "when we received it".
  ///
  /// NOT NULL: the migration backfills every existing row from `created_at`,
  /// and the route always supplies a value — the device's when it sent a
  /// usable one, the received time otherwise (see `captureTime.ts`). So no
  /// query needs a COALESCE and no reader has to decide what a null means.
  /// The `now()` default is only a floor for a direct database insert.
  capturedAt DateTime    @default(now()) @map("captured_at")
  lines      OrderLine[]

  @@index([clientId])
  @@map("orders")
}

model OrderLine {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  order     Order  @relation(fields: [orderId], references: [id])
  skuId     String @map("sku_id")
  sku       Sku    @relation(fields: [skuId], references: [id])
  quantity  Int
  unitPrice Float  @map("unit_price")

  @@map("order_lines")
}

/// Direct/group field message (Phase 3 #37). `recipientId` null = broadcast
/// within the client.
model Message {
  id              String              @id @default(uuid())
  clientId        String              @map("client_id")
  client          Client              @relation(fields: [clientId], references: [id])
  senderId        String              @map("sender_id")
  sender          User                @relation("MessageSender", fields: [senderId], references: [id])
  recipientId     String?             @map("recipient_id")
  recipient       User?               @relation("MessageRecipient", fields: [recipientId], references: [id])
  body            String
  readAt          DateTime?           @map("read_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  attachments     MessageAttachment[]
  /// The sender's idempotency key for this message (#308): generated by the
  /// client once per composed message and sent as `clientMessageId` on
  /// `POST /messages`, so a retry after a lost response returns this row
  /// instead of creating a second one. Null for messages sent without one.
  /// Unique per sender, not globally — two users' keys never collide, and
  /// Postgres treats NULLs as distinct, so keyless messages are unconstrained.
  clientMessageId String?             @map("client_message_id")

  @@unique([senderId, clientMessageId])
  @@index([clientId])
  @@index([recipientId])
  @@map("messages")
}

/// An image attached to a message (#125).
///
/// IMAGES ONLY, by design: attachments reuse the existing photo pipeline
/// (`POST /photos`, base64 in Postgres per ADR 0007, and its thumbnail route)
/// rather than a general-purpose file store. There is no PDF or arbitrary-file
/// support — that would need real object storage first.
///
/// `photoId` is unique: a photo is attached to at most one message, so the
/// access grant an attachment confers (see photos.service) has exactly one
/// source. A message carries at most MAX_MESSAGE_ATTACHMENTS (4), in
/// `position` order.
model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  photoId   String   @unique @map("photo_id")
  photo     Photo    @relation(fields: [photoId], references: [id])
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("message_attachments")
}

/// A broadcast announcement to the client's field team (Phase 3 #37).
model Announcement {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("announcements")
}

/// An outbound webhook subscription (Phase 3 #38). Fired on matching events
/// (e.g. visit.submitted, order.created, alert.raised).
model Webhook {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  url       String
  event     String
  secret    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  /// Health (#100). Deliveries that gave up since the last success. Reset to 0
  /// by any successful delivery; the webhook reads as unhealthy while > 0.
  consecutiveFailures Int                    @default(0) @map("consecutive_failures")
  /// The outcome and time of the most recent delivery attempt, stored rather
  /// than derived: the list endpoint would otherwise need the newest delivery
  /// per webhook, and Prisma paginates nested relations in memory.
  lastDeliveryStatus  WebhookDeliveryStatus? @map("last_delivery_status")
  lastDeliveryAt      DateTime?              @map("last_delivery_at")
  deliveries          WebhookDelivery[]

  @@index([clientId, event, active])
  @@map("webhooks")
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  failed_retrying
  gave_up
}

/// One event delivered to one webhook (#100) — the outbox row that makes the
/// fan-out retryable and auditable. The payload is the exact envelope sent, so
/// every retry re-sends the same body; only the signature timestamp changes.
model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookId      String                @map("webhook_id")
  webhook        Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  /// Denormalised from the webhook so the deliveries endpoint scopes by tenant
  /// without a join.
  clientId       String                @map("client_id")
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(pending)
  attempts       Int                   @default(0)
  lastStatusCode Int?                  @map("last_status_code")
  lastError      String?               @map("last_error")
  /// When the row is next due. Also the claim lease: a processor that takes a
  /// row pushes this forward, so nobody else picks it up mid-attempt.
  nextAttemptAt  DateTime?             @map("next_attempt_at")
  lastAttemptAt  DateTime?             @map("last_attempt_at")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

/// A saved report definition (Phase 3 #39) — a named, filtered report the
/// manager can generate on demand, or on a cadence via a ReportSchedule (#66).
model ReportDefinition {
  id        String           @id @default(uuid())
  clientId  String           @map("client_id")
  client    Client           @relation(fields: [clientId], references: [id])
  name      String
  type      String // visits | scorecards | tasks | orders
  filters   Json
  createdAt DateTime         @default(now()) @map("created_at")
  schedules ReportSchedule[]

  @@index([clientId])
  @@map("report_definitions")
}

/// A reward scheme that turns field performance into agent incentives
/// (Phase 3 #34, the reward side of gamification).
model IncentiveScheme {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  client       Client   @relation(fields: [clientId], references: [id])
  name         String
  metric       String // scorecard | tasks_closed | visits
  threshold    Float
  rewardPoints Int      @map("reward_points")
  rewardDetail String?  @map("reward_detail")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([clientId, active])
  @@map("incentive_schemes")
}

/// One points-earning event for one agent (#124). The leaderboard is a sum over
/// these rows in its window, so every point on it can be traced back to the
/// visit, task or scorecard that earned it — and audited, disputed or explained.
///
/// `reason` says what was rewarded; `sourceType` + `sourceId` say which record
/// did it. The source is polymorphic on purpose (no FK): a ledger row outlives
/// nothing it points at being edited, and one table serves every reason.
///
/// Reasons in use (see src/modules/gamification/pointsLedger.ts):
/// - `visit_submitted` (+2, source `visit`, occurredAt = checkinTs)
/// - `task_closed`     (+5, source `task`,  occurredAt = when it was closed)
/// - `scorecard`       (0 points, source `scorecard`, `score` = weightedTotal,
///                      occurredAt = scorecard createdAt). The formula adds the
///                      *mean* score in the window, which no per-event sum can
///                      express, so the entry carries the score it contributes
///                      to that mean rather than pretending to a fixed amount.
///
/// `points` may be negative, for later manual adjustments.
///
/// Unique on (sourceType, sourceId, reason): writing an event twice is a no-op,
/// so the write hooks and the backfill can both run any number of times.
///
/// Cascades from Client/User: users are deactivated, not deleted, in practice;
/// the cascade only stops a tenant/user teardown being blocked by derived rows.
model PointsLedgerEntry {
  id         String   @id @default(uuid())
  clientId   String   @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId    String   @map("agent_id")
  agent      User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  points     Int
  reason     String
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id")
  /// The value a non-additive reason contributes (the scorecard's
  /// weightedTotal). Null for reasons that are a plain points amount.
  score      Float?
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([sourceType, sourceId, reason])
  @@index([clientId, agentId, occurredAt])
  @@index([clientId, occurredAt])
  @@map("points_ledger_entries")
}

/// A recurring delivery of a saved report (Phase 3 #39; fired by the schedule
/// worker since #66 — see src/modules/reportschedules/reportschedules.worker.ts).
model ReportSchedule {
  id                 String              @id @default(uuid())
  clientId           String              @map("client_id")
  client             Client              @relation(fields: [clientId], references: [id])
  reportDefinitionId String              @map("report_definition_id")
  reportDefinition   ReportDefinition    @relation(fields: [reportDefinitionId], references: [id])
  cadence            String // daily | weekly
  recipients         Json
  /// When the schedule last ran, by the worker or by "run now".
  lastRunAt          DateTime?           @map("last_run_at")
  /// When the worker next fires it (#66). Null while paused. Advanced from the
  /// due time it replaces, never from when the run happened to finish, so the
  /// time of day does not drift. See reportschedules.cadence.ts.
  nextRunAt          DateTime?           @map("next_run_at")
  /// The claim lease: a worker that takes a due schedule sets this, so no other
  /// instance picks it up mid-run. A crashed run is retried once it lapses.
  claimedUntil       DateTime?           @map("claimed_until")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at")
  runs               ReportScheduleRun[]

  @@index([clientId])
  @@index([active, nextRunAt])
  @@map("report_schedules")
}

/// One run of a report schedule (#66): scheduled by the worker, or manual.
///
/// Stores what happened, not the report: the rows are regenerated when the run's
/// CSV is downloaded (bounded to the run's `generatedAt`), so a schedule firing
/// daily does not keep a copy of a tenant's whole visit history per day.
///
/// Unique on (scheduleId, dueAt): a scheduled due time fires at most one run,
/// even if two workers ever raced for it. Manual runs have no due time, and
/// Postgres treats NULLs as distinct, so they never collide.
model ReportScheduleRun {
  id          String         @id @default(uuid())
  scheduleId  String         @map("schedule_id")
  schedule    ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// Denormalised from the schedule so the download endpoint scopes by tenant
  /// without a join.
  clientId    String         @map("client_id")
  trigger     String // scheduled | manual
  /// The due time a scheduled run fired for; null for a manual run.
  dueAt       DateTime?      @map("due_at")
  generatedAt DateTime       @map("generated_at")
  rowCount    Int            @map("row_count")
  /// Per-channel outcomes (ReportDeliveryOutcome[]): webhook deliveries queued,
  /// email not configured, and so on.
  deliveries      Json
  createdAt       DateTime              @default(now()) @map("created_at")
  emailDeliveries ReportEmailDelivery[]

  @@unique([scheduleId, dueAt])
  @@index([clientId, scheduleId, createdAt])
  @@map("report_schedule_runs")
}

/// One report run emailed to one recipient (#66) — the email counterpart of a
/// WebhookDelivery, with the same statuses, retry schedule and claim lease
/// (reportschedules.email.ts). One row per recipient, so one bad mailbox never
/// holds up, or re-sends to, the others.
///
/// The message itself is not stored: it is rebuilt on every attempt from the
/// run (the CSV is regenerated bounded to the run's `generatedAt`), so a row
/// stays a few hundred bytes whatever the report size.
model ReportEmailDelivery {
  id            String                @id @default(uuid())
  runId         String                @map("run_id")
  run           ReportScheduleRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Denormalised from the run so the delivery log scopes by tenant without a
  /// join.
  clientId      String                @map("client_id")
  recipient     String
  status        WebhookDeliveryStatus @default(pending)
  attempts      Int                   @default(0)
  lastError     String?               @map("last_error")
  /// When the row is next due. Also the claim lease, as on webhook_deliveries.
  nextAttemptAt DateTime?             @map("next_attempt_at")
  lastAttemptAt DateTime?             @map("last_attempt_at")
  deliveredAt   DateTime?             @map("delivered_at")
  /// Whether the delivered message carried the CSV (false: link only, over the
  /// attachment cap). Null until delivered.
  csvAttached   Boolean?              @map("csv_attached")
  createdAt     DateTime              @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([runId, createdAt])
  @@map("report_email_deliveries")
}

/// A persisted, refinable view produced by a tool call in an assistant turn.
///
/// **Stores what to re-run, never what was returned.** The row carries the tool
/// name and its parameters; the data is fetched fresh on every read by invoking
/// that tool again through the caller's own roster. Caching the result here
/// would create a second copy of tenant data with its own staleness and its own
/// access-control story — the thing the tool closure exists to avoid.
///
/// `userId` scopes an artifact to the person whose conversation produced it.
/// Tenant scoping alone would let one manager refine a colleague's artifact,
/// which is not a data leak (the roster still re-authorises every run) but is
/// someone else's workspace.
model AssistantArtifact {
  id              String    @id @default(uuid())
  clientId        String    @map("client_id")
  client          Client    @relation(fields: [clientId], references: [id])
  userId          String    @map("user_id")
  conversationId  String    @map("conversation_id")
  /// The view-spec type from the closed catalog — `trend_chart`, `outlet_map`, …
  type            String
  toolName        String    @map("tool_name")
  params          Json
  /// Previous params, oldest first, for undo. Capped in the service layer.
  paramsHistory   Json      @default("[]") @map("params_history")
  /// Set when the USER moved a control, cleared once a turn has told the model.
  /// Non-null means the model's picture of this view is stale — it is reasoning
  /// from whatever params it last saw, which is no longer what is on screen.
  /// A timestamp rather than a boolean so the notes can be ordered when several
  /// views moved between two turns.
  paramsChangedAt DateTime? @map("params_changed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([clientId, userId, conversationId])
  @@map("assistant_artifacts")
}

/// Every write the assistant attempted — including the ones it was not allowed
/// to make.
///
/// **A ledger, not a log.** Rows are written before the action runs and updated
/// with its outcome, so an action that crashed mid-flight leaves a row saying
/// so rather than leaving no trace. "No row" therefore means "never attempted",
/// which is the property that makes this answerable in an incident.
///
/// Refusals are recorded for the same reason: a tenant asking for something it
/// cannot have is the signal worth keeping, and a ledger of successes only
/// cannot distinguish "nobody tried" from "somebody tried repeatedly".
model AssistantAction {
  id             String    @id @default(uuid())
  clientId       String    @map("client_id")
  client         Client    @relation(fields: [clientId], references: [id])
  /// Who asked. Not a relation: a user may be deleted and the ledger must
  /// outlive them, which is the whole point of an audit trail.
  userId         String    @map("user_id")
  conversationId String?   @map("conversation_id")
  toolName       String    @map("tool_name")
  /// The tier AT THE TIME. Denormalised on purpose — re-deriving it from
  /// risk.ts when the ledger is read would rewrite history every time the
  /// policy table changes, and "what did we consider risky then" is exactly
  /// what an auditor asks.
  tier           String
  /// The validated arguments, as the tool's own schema returned them. Never
  /// the model's raw text — the point of comparison later is what RAN.
  args           Json
  /// requested · awaiting_confirmation · executed · refused · rejected · failed
  outcome        String
  /// Why, when the outcome was refused, rejected or failed. Null otherwise.
  detail         String?
  /// What an undo would need for a `reversible` action — the created row's id,
  /// the previous value. Null for tiers that cannot be undone this way.
  undoContext    Json?     @map("undo_context")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  /// The audit view filters by tenant and orders by time; the second index
  /// serves "everything this person did", which is the first question asked
  /// when something looks wrong.
  @@index([clientId, createdAt])
  @@index([clientId, userId, createdAt])
  @@map("assistant_actions")
}

/// One foreground location heartbeat from a field agent (#153 T1).
///
/// Sent only while the app is open, the agent is signed in, and they have
/// acknowledged the location notice (LocationConsent). Pings queue in the
/// app's offline outbox, so they arrive LATE and OUT OF ORDER: everything that
/// reads them orders by `recordedAt` (the device's fix time), never by
/// `createdAt` (arrival).
///
/// Retention (#178): raw rows are kept 90 days, then folded into an
/// AgentDaySummary and deleted; a deactivated agent's rows are folded and
/// deleted at once. See src/modules/locations/locationRetention.ts.
model AgentLocationPing {
  id         String   @id @default(uuid())
  clientId   String   @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId    String   @map("agent_id")
  agent      User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  /// The platform's horizontal accuracy estimate in metres, when it gave one.
  accuracyM  Float?   @map("accuracy_m")
  /// When the device took the fix. The ordering key for everything.
  recordedAt DateTime @map("recorded_at")
  /// What produced the ping. Only `foreground` exists (T1); T2 background
  /// tracking is a separate, POPIA-gated decision and would add its own value.
  source     String
  /// Arrival on the server. Diagnostic only — never an ordering key.
  createdAt  DateTime @default(now()) @map("created_at")

  /// One agent cannot be in two places at the same instant, so this is the
  /// idempotency key: an outbox batch re-sent after a lost response inserts
  /// nothing new.
  @@unique([agentId, recordedAt])
  @@index([clientId, agentId, recordedAt])
  /// The retention job walks the oldest pings first.
  @@index([recordedAt])
  @@map("agent_location_pings")
}

/// What survives of an agent's day once its raw pings are pruned (#178).
///
/// `day` is a calendar date in the client's own timezone (Client.timezone,
/// #309), stored as UTC midnight of that date — the clientTime.ts convention.
model AgentDaySummary {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId     String   @map("agent_id")
  agent       User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  day         DateTime @db.Date
  firstPingAt DateTime @map("first_ping_at")
  lastPingAt  DateTime @map("last_ping_at")
  pingCount   Int      @map("ping_count")
  /// Ordered by arrival: [{ outletId, outletName, arrivedAt, leftAt, pingCount }].
  /// Consecutive pings inside the same outlet geofence form one stop.
  stops       Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([agentId, day])
  @@index([clientId, day])
  @@map("agent_day_summaries")
}

/// An agent's answer to the in-app location notice (#153, POPIA risk 1).
///
/// Append-only: every acknowledgement and every decline is a row, so the
/// history of what an agent agreed to, and when, is never overwritten. The
/// latest row for the current notice version is the agent's position.
model LocationConsent {
  id            String   @id @default(uuid())
  clientId      String   @map("client_id")
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agentId       String   @map("agent_id")
  agent         User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Which wording of the notice they saw. A changed notice needs a new answer.
  noticeVersion String   @map("notice_version")
  /// acknowledged · declined
  decision      String
  /// When the agent tapped, on the device clock (an answer may queue offline).
  decidedAt     DateTime @map("decided_at")
  /// When the server recorded it.
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([clientId, agentId, createdAt])
  @@map("location_consents")
}

/// A time-boxed competition over the points ledger (#124): agents ranked by
/// the points they earn between two dates, for a prize.
///
/// `startDate` / `endDate` are calendar dates, inclusive, counted in
/// Client.timezone — the campaign window rules (#324, campaignWindow.ts).
///
/// Status is not stored. It is computed from the dates and the client's
/// "today": upcoming, active or ended — or cancelled once `cancelledAt` is set,
/// which hides the contest from agents.
///
/// `territoryId` scopes the contest to agents assigned to that territory.
/// `eventTypes` lists the ledger reasons that count; empty means all of them.
/// See src/modules/contests/contestStandings.ts for the ranking rules.
model Contest {
  id               String     @id @default(uuid())
  clientId         String     @map("client_id")
  client           Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  /// Free text: what the winner gets.
  prizeDescription String?    @map("prize_description")
  startDate        DateTime   @map("start_date") @db.Date
  endDate          DateTime   @map("end_date") @db.Date
  territoryId      String?    @map("territory_id")
  /// Restrict: deleting a territory must not silently widen its contests to
  /// the whole client.
  territory        Territory? @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  eventTypes       String[]   @default([]) @map("event_types")
  createdById      String     @map("created_by_id")
  createdBy        User       @relation("ContestCreator", fields: [createdById], references: [id])
  cancelledAt      DateTime?  @map("cancelled_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([clientId, endDate])
  @@map("contests")
}

enum PushPlatform {
  android
  ios
  web
}

/// The kinds of push a user can switch off (#67).
enum NotificationCategory {
  alerts
  tasks
  messages
  sla
}

/// A device's push token (FCM registration token), registered by the app after
/// sign-in and removed on sign-out (#67).
///
/// The token is globally unique: it names one app install, not one person. When
/// a shared phone signs in as someone else, registering the same token again
/// re-points this row to the new user and tenant, so the previous user stops
/// receiving pushes on a phone they have handed back.
model DeviceToken {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String       @map("client_id")
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform   PushPlatform
  token      String       @unique
  /// Last registration or refresh. A token FCM rejects is deleted outright.
  lastSeenAt DateTime     @map("last_seen_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@index([clientId])
  @@map("device_tokens")
}

/// One user's choice for one push category (#67). No row means ON: every
/// category defaults to enabled, so a row is only written when a user changes
/// something.
model NotificationPreference {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String               @map("client_id")
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@unique([userId, category])
  @@index([clientId])
  @@map("notification_preferences")
}

/// A manager's monthly sell-in target for one SKU (#119).
///
/// **Sell-in, not sell-out.** The actual this is measured against is units
/// ordered through TradeIQ (`OrderLine.quantity` on non-cancelled orders), not
/// what shoppers bought. There is no POS feed; label it "Sell-in (orders)".
/// `VisitStock.salesActual` / `salesTarget` are NOT this and stay unused.
///
/// `month` is a calendar date — the first of the month at UTC midnight, the
/// `clientTime.ts` convention — and is read as the whole month of local days
/// in `Client.timezone` when actuals are computed.
///
/// Scope is the whole client (both null), one territory, or one outlet — never
/// both (a CHECK constraint in the migration). Uniqueness over the scope is an
/// expression index on COALESCE(territory_id, '') / COALESCE(outlet_id, '')
/// that Prisma cannot express, so it lives only in the migration: a plain
/// @@unique would let two client-wide rows coexist, because Postgres treats
/// NULLs as distinct.
model SalesTarget {
  id          String     @id @default(uuid())
  clientId    String     @map("client_id")
  client      Client     @relation(fields: [clientId], references: [id])
  skuId       String     @map("sku_id")
  sku         Sku        @relation(fields: [skuId], references: [id], onDelete: Cascade)
  month       DateTime   @db.Date
  territoryId String?    @map("territory_id")
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  outletId    String?    @map("outlet_id")
  outlet      Outlet?    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  targetUnits Int        @map("target_units")
  createdById String     @map("created_by_id")
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([clientId, month])
  @@index([skuId])
  @@map("sales_targets")
}
