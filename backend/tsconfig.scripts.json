{
  // scripts/ is not part of the build — dist/ must stay rooted at src/ so
  // `node dist/server.js` (npm start, and the Dockerfile CMD) keeps working.
  // But leaving scripts/ out of tsconfig.json entirely meant it was never
  // typechecked at all: the seed broke against a schema change and `tsc`
  // reported success. This config exists purely to check it.
  //
  // evals/ is here for exactly the same reason. It is reachable only from a
  // `*.test.ts`, which tsconfig.json excludes, so it was invisible to both
  // `build` and `typecheck` — the golden question set could have drifted out of
  // sync with the tool registry and `tsc` would still have reported success.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["scripts", "src", "evals"]
}
