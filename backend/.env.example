DATABASE_URL="postgresql://tradeiq:tradeiq_dev@localhost:5432/tradeiq?schema=public"
JWT_SECRET=
PORT=4000

# Optional: seeds the demo "home base" outlet at your own location so a live
# geofence check-in can be demonstrated. Both must be set to take effect.
# The geofence is 50m and check-in is REJECTED outside it, so use precise
# coordinates. Unset, the seed falls back to a generic Johannesburg point.
DEMO_HOME_LAT=
DEMO_HOME_LNG=

# ── Scheduled report email and download links (#66) ───────────────────────────
# Email is OFF while SMTP_HOST and SMTP_FROM are unset: runs record the email
# channel as not_configured, with the reason. Any SMTP provider works (Google
# Workspace, Microsoft 365, Amazon SES, Resend). Partly set or malformed is also
# off, and the startup log says why. See docs/operations/report-email.md.
#
# SMTP_PORT defaults to 465 when SMTP_SECURE=true, otherwise 587 (STARTTLS).
# SMTP_USER and SMTP_PASS go together; with a login, TLS is required.
# Locally, a mail catcher keeps everything on your machine:
#   docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost SMTP_PORT=1025 SMTP_FROM="TradeIQ Reports <reports@localhost.test>"
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# The API's public origin, used in links it hands out. Production sets it in
# fly.toml. Signed CSV download links (no bearer token needed, one run of one
# tenant, 7-day expiry) need it AND REPORT_LINK_SECRET.
PUBLIC_API_URL=http://localhost:4000

# HMAC key for signed download links, at least 32 characters. Its own key, not
# JWT_SECRET: rotating it revokes every outstanding link and nothing else.
#   openssl rand -base64 48
REPORT_LINK_SECRET=

# ── Conversational TradeIQ (#253) ─────────────────────────────────────────────
# Which provider the orchestrator runs. Pinned per conversation, never per turn:
# history carries vendor-specific artifacts (thinking blocks, tool-call shapes)
# that do not transfer, and switching invalidates the cached prefix.
LLM_PROVIDER=gemini

# Only the key for the selected LLM_PROVIDER is required to boot. The other may
# stay empty — the second adapter exists so the swap is a config flag, not a
# rewrite, and an unset key for an unused provider must not fail startup.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Which Gemini models to run. Optional — these are the defaults.
#
# Override the orchestrator to a cheap tier while testing: every turn is a
# metered call, and tool SELECTION (the thing Phase 0 is gated on) is largely
# insensitive to model size, so a Flash-class model exercises the whole spine
# for a fraction of the spend. Put the good model back before quoting an
# accuracy number — the eval gate is stated per model, not per provider.
#
# The quarantine pass is already the cheap tier and should stay there: it is a
# tool-less summarisation call over free text, not reasoning.
# `-preview` is the real name. `gemini-3.1-pro` 404s — there is no GA 3.1 Pro.
GEMINI_ORCHESTRATOR_MODEL=gemini-3.1-pro-preview
GEMINI_QUARANTINE_MODEL=gemini-3.6-flash

# How hard Gemini thinks, per kind of round: minimal | low | medium | high, or
# empty for the vendor default. Optional — these are the defaults.
#
# Thinking is billed as output, and output is the most expensive token there
# is. The round that writes the ANSWER has every figure in front of it already
# and no decision left but phrasing, so it runs low; measured, it was spending
# over half a turn's output tokens on a few hundred characters of prose. The
# rounds that CHOOSE TOOLS are left at the vendor default, because that is
# where a wrong turn costs a whole extra round and where the eval gate scores.
# GEMINI_THINKING_LEVEL=
# GEMINI_ANSWER_THINKING_LEVEL=low

# A ceiling on one round's generation, thinking included. A runaway guard, not
# a cost dial — the thinking levels above are the dial. Optional.
# GEMINI_MAX_OUTPUT_TOKENS=8192

# Cost accounting, in USD per million tokens. Optional.
#
# ⚠️ The defaults are PLACEHOLDERS seeded from the plan's cost table and have
# not been confirmed against Google's pricing page. If you switch
# GEMINI_ORCHESTRATOR_MODEL to a cheaper tier, these become wrong in the
# expensive direction — set them to match, or read `costCents` as an upper
# bound rather than a figure.
GEMINI_INPUT_USD_PER_MTOK=2
GEMINI_OUTPUT_USD_PER_MTOK=12
GEMINI_CACHED_INPUT_USD_PER_MTOK=0.2

# Which Claude models to run when LLM_PROVIDER=anthropic. Optional — these are
# the defaults. The orchestrator is Claude Sonnet 5 with adaptive thinking; the
# quarantine pass is the cheap, tool-less tier and runs without thinking.
# Needs ANTHROPIC_API_KEY above (not set anywhere yet — add it to backend/.env
# and to the deploy's secrets when the switch is made).
ANTHROPIC_ORCHESTRATOR_MODEL=claude-sonnet-5
ANTHROPIC_QUARANTINE_MODEL=claude-haiku-4-5-20251001

# Cost accounting for Anthropic, in USD. Optional. Seeded from the published
# Sonnet 5 rates and $10 per 1,000 web searches; confirm before trusting a
# dashboard, and re-set them if you change the orchestrator model.
ANTHROPIC_INPUT_USD_PER_MTOK=2
ANTHROPIC_OUTPUT_USD_PER_MTOK=10
ANTHROPIC_CACHED_INPUT_USD_PER_MTOK=0.2
ANTHROPIC_CACHE_WRITE_USD_PER_MTOK=2.5
ANTHROPIC_WEB_SEARCH_USD=0.01

# Anthropic request tuning. Optional. One SDK retry and a 60s timeout so an
# outage reaches the Gemini fallback quickly; max tokens covers thinking + answer.
ANTHROPIC_MAX_RETRIES=1
ANTHROPIC_TIMEOUT_MS=60000
ANTHROPIC_MAX_TOKENS=32000

# Outage fallback. With LLM_PROVIDER=anthropic AND a GEMINI_API_KEY set, a turn
# whose Anthropic call fails with an outage (5xx, overloaded, timeout, network)
# BEFORE any output reached the user is answered on Gemini instead. Never
# mid-stream, never on a 4xx/auth/rate-limit error. Traces carry
# `fallbackFrom: anthropic` when it happens. Set to `off` for single-vendor
# measurement (the eval sweep does this implicitly by withholding the Gemini key).
LLM_FALLBACK=on

# Live web search (cited, labelled outside information) is switched per client
# with `clients.assistant_web_search_enabled` (default true), not here. Anthropic
# uses its server-side web search; Gemini uses Google Search grounding on Gemini 3
# models only, and on anything older search is simply not offered.

# Langfuse Cloud. Tracing is wired in from the first request, not added later:
# Phase 0 exits with a measured cost-per-conversation rather than an estimate,
# and the cache-hit assertion is a cost regression test as much as a functional
# one — a silently invalidated prefix multiplies spend while every test passes.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Send conversation TEXT to Langfuse, not just metrics. Default off, and leave
# it off until someone answers #251 Q3 (transcript retention) and Q4 (POPIA
# residency): transcripts carry outlet names, agent identities and visit notes.
# Tool RESULTS are never sent regardless of this setting.
LANGFUSE_TRACE_CONTENT=false

# Assistant rate limits — two, because they bound different things. The per-user
# cap stops one manager hammering the composer; the per-tenant cap bounds the
# bill, since forty managers each inside their own allowance are still forty
# times the spend. Both key on the JWT rather than the IP, so a team behind one
# corporate NAT is not throttled for its colleagues' usage.
#
# NEITHER bounds the account. A leaked provider key is not rate-limited by
# anything in this repo; that ceiling belongs in the provider console.
ASSISTANT_USER_RATE_WINDOW_MS=60000
ASSISTANT_USER_RATE_MAX=20
ASSISTANT_TENANT_RATE_WINDOW_MS=60000
ASSISTANT_TENANT_RATE_MAX=120

# Soft per-turn cost ceiling, in US cents. Optional — 30 is the default.
#
# Soft: reaching it does not cut the turn off, it withdraws the tools so the
# model answers from what it already retrieved and tells the user the answer may
# be incomplete. A turn costs single-digit cents, so one passing thirty has gone
# wrong in a way more rounds will not fix.
# ASSISTANT_TURN_COST_BUDGET_CENTS=30

# Per-round token and tool-result accounting to stderr. Off unless set, and
# never on a user path — a turn's bill is the sum of what each round RE-SENDS,
# and a per-turn total cannot tell the frozen prefix from the growing tail.
# ASSISTANT_COST_DEBUG=1

# Competitor shelf prices from retailer websites — BUILT AND OFF.
# Reading retailer websites usually conflicts with their terms of use, so this
# stays `off` until the legal checklist in
# docs/operations/competitor-price-collection.md is signed off. `off` (or
# anything other than exactly `on`) overrides every client's own switch: no
# requests are sent, nothing is scheduled, and the assistant tool is not declared.
COMPETITOR_PRICE_COLLECTION=off
# Required before any request: a contact URL or email for the honest User-Agent
# ("TradeIQPriceBot/1.0 (+<contact>; ...)"). Collection refuses to run without it.
COMPETITOR_PRICE_BOT_CONTACT=
# Politeness. Per-domain spacing cannot go below 10000 ms whatever is set here.
COMPETITOR_PRICE_DOMAIN_INTERVAL_MS=15000
COMPETITOR_PRICE_GLOBAL_INTERVAL_MS=3000
COMPETITOR_PRICE_DAILY_CAP=50
# A price older than this is flagged stale and never presented as current.
COMPETITOR_PRICE_STALE_DAYS=7
