<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) splits what android:allowBackup used to cover into two
  channels, and excludes each separately:

    <cloud-backup>  — Google Drive / Auto Backup
    <device-transfer> — direct phone-to-phone migration

  Everything is excluded from both. The local database holds GPS check-in
  trails and base64 shelf photos in plain SQLite (#138), and secure storage
  holds the auth token; none of it should leave the device by a path this app
  neither initiates nor can revoke.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
