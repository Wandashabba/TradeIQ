<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Must live in the MAIN manifest, not just debug/profile. Flutter's
         template ships INTERNET in src/debug and src/profile only, so a release
         build silently loses all network access: the app installs and runs, and
         every API call fails. See #137. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Background location tracking between stores (#153 T2). ANDROID ONLY:
         there is no iOS counterpart, and that is a decision rather than an
         oversight — see ios/Runner/Info.plist, which says so in place.

         ACCESS_BACKGROUND_LOCATION is requested ONLY after the agent has
         accepted the separate background-tracking notice, and Android's own
         two-step flow is followed: the while-in-use prompt first, then the
         "Allow all the time" choice, which from Android 11 the system will only
         accept from its own Settings screen. Declaring it here does not grant
         it; refusing it leaves every other part of the app working.

         FOREGROUND_SERVICE + FOREGROUND_SERVICE_LOCATION (required from Android
         14) are what let geolocator run its GeolocatorLocationService with a
         permanent, non-dismissable notification while tracking is on. Android
         requires the notification, and it is also the honest thing to show: an
         agent must always be able to see that their route is being recorded.

         WAKE_LOCK keeps the ten-minute timer honest while the phone dozes. See
         docs/operations/background-location.md. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Declared for the closure and S3-S4/S5 section photo capture (#41).
         image_picker delegates to the system camera app, so this is belt-and-
         braces rather than strictly required — but it is declared deliberately
         instead of relying on intent behaviour. See #148. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Backup is off deliberately. Android copies app data to the user's Google
         account by default, which would sweep up tradeiq_local.sqlite — GPS
         check-in trails and base64 shelf photos, in plain SQLite (#138) — to
         somewhere this app cannot reach, audit, or delete.

         allowBackup covers Android 11 and below; dataExtractionRules governs
         cloud backup and device-to-device transfer on Android 12+, where
         allowBackup alone no longer decides transfer. Both are needed. -->
    <application
        android:label="tradeiq_app"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- url_launcher: open a cited web source in the browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
