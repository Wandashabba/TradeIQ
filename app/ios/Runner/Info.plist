<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Tradeiq App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>tradeiq_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iOS is deliberately FOREGROUND-ONLY, and stays that way (#153 T2).

	     Background location tracking between stores shipped for Android only.
	     This file therefore declares NSLocationWhenInUseUsageDescription and
	     nothing else: there is no NSLocationAlwaysAndWhenInUseUsageDescription
	     and no UIBackgroundModes "location" entry, so iOS cannot grant Always
	     authorisation and CoreLocation stops delivering the moment TradeIQ
	     leaves the foreground. The app enforces the same rule in code —
	     backgroundLocationGatewayProvider is null on every platform but Android
	     — so the two cannot drift apart.

	     Adding either key here would be a real decision, not a config tweak: it
	     needs its own App Store review justification and a demo video, on top of
	     the POPIA position. Do not add one to "match Android".

	     The description below is what an iOS user is actually promised, and its
	     last sentence must stay true for as long as this stays foreground-only. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>While TradeIQ is open, it uses your location to confirm you're at the outlet you're checking into and to share which store you're at with your manager. Nothing is sent in the background.</string>
	<key>NSCameraUsageDescription</key>
	<string>TradeIQ needs your camera to photograph shelves and to prove a task was completed in store.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TradeIQ needs your photo library so you can attach a shelf photo you already took.</string>
</dict>
</plist>
