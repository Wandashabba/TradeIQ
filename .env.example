DATABASE_URL="postgresql://tradeiq:tradeiq_dev@localhost:5432/tradeiq?schema=public"
# Generate a unique secret per environment: `openssl rand -base64 48`
# The backend REFUSES to start with this placeholder unless NODE_ENV is
# explicitly `development` or `test`.
JWT_SECRET="dev-only-change-me"
PORT=4000

# Comma-separated allowlist of frontend origins for CORS. Leave unset in local
# dev (falls back to an open policy); set it in production, e.g.
# CORS_ORIGINS="https://app.tradeiq.com,https://admin.tradeiq.com"
# CORS_ORIGINS=

# Login rate limiting (per IP). Defaults: 10 attempts per 15 minutes.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
